# Publiczny adres strony (canonical, OG, sitemap, JSON-LD).
# Domena nieustalona: kod ma fallback na https://no-fuss.pl (src/lib/seo/site-url.ts).
NEXT_PUBLIC_SITE_URL=https://no-fuss.pl

# Formularz kontaktu w stopce (Server Action → Resend API, src/lib/contact/action.ts).
# Bez obu zmiennych formularz nie wysyła: pokazuje błąd z adresem e-mail, powód w logu serwera.
RESEND_API_KEY=
# Nadawca w domenie zweryfikowanej w Resend. Odbiorca: site.contact.email, Reply-To: adres z formularza.
CONTACT_FROM="no-fuss <formularz@no-fuss.house>"
