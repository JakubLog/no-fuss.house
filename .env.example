# Publiczny adres strony (canonical, OG, sitemap, JSON-LD).
# Domena: https://no-fuss.house (ten sam adres jest fallbackiem w src/lib/seo/site-url.ts; zły format → ostrzeżenie w logu i fallback).
NEXT_PUBLIC_SITE_URL=https://no-fuss.house

# Formularz kontaktu w stopce (Server Action → Resend API, src/lib/contact/action.ts).
# Bez tych trzech zmiennych formularz nie wysyła: pokazuje błąd z adresem e-mail, powód w logu serwera.
RESEND_API_KEY=
# Nadawca w domenie zweryfikowanej w Resend. Reply-To: adres z formularza.
CONTACT_FROM="no-fuss <formularz@mailing.no-fuss.house>"
# Odbiorcy powiadomień o zgłoszeniach (zespół), po przecinku. Tylko w env: repozytorium jest publiczne.
CONTACT_TO=
